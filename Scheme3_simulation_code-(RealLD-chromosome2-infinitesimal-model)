# Function to simulate one replicate for a given parameter set
simulate_summary <- function(
    J = 3327,
    n_exp = 400,
    n_out = 90000,
    PVE_x = 0.1,
    PVE_y = 0.2,
    PVE_GY = 0.0, 
    tau = 0
){
  Sigma <- Sigma_reg
  L <- chol(Sigma)
  
  # 1. Simulate raw SNP effects on expression (small effects for all SNPs - infinitesimal model)
  beta_raw <- rnorm(J)
  
  S <- as.numeric(t(beta_raw) %*% Sigma %*% beta_raw)
  w <- PVE_x / S
  beta_E <- sqrt(w) * beta_raw
  
  sigma_x2 <- 1 - PVE_x
  
  ## MR causal estimate: γ = sqrt(PVE_y)
  gamma <- sqrt(PVE_y)
  
  ## Simulate true pleiotropic effect θ* = ε + τ
  theta_star <- rnorm(J) + tau    # <-- τ added here
  
  ### Scale θ via σ
  S_theta <- as.numeric(t(theta_star) %*% Sigma %*% theta_star)
  sigma_theta <- sqrt(PVE_GY / S_theta)
  
  ## θ = σ θ*
  theta <- sigma_theta * theta_star
  
  ## SNP-outcome association estimate — β_G = θ + γ β_E
  beta_G <- theta + gamma * beta_E
  
  #### Observed eQTL statistics
  var_eps_E <- (1 - PVE_x) / n_exp
  eps_E <- L %*% rnorm(J, 0, sqrt(var_eps_E))
  
  beta_E_hat <- Sigma %*% beta_E + eps_E
  se_E <- rep(sqrt(var_eps_E), J)
  
  #### Observed GWAS outcome statistics
  var_eps_G <- (1 - PVE_x * gamma^2 - PVE_GY) / n_out
  eps_G <- L %*% rnorm(J, 0, sqrt(var_eps_G))
  
  beta_G_hat <- Sigma %*% beta_G + eps_G
  se_G <- rep(sqrt(var_eps_G), J)
  
  #### Conditional bx, by (SNP-exposure/outcome assoc estimate) for LDA-Egger
  LD_inv = solve(Sigma)
  
  b_exp_cond = LD_inv %*% beta_E_hat
  b_out_cond = LD_inv %*% beta_G_hat
  
  Sig_exp = LD_inv %*% (Sigma * crossprod(t(se_E))) %*% LD_inv
  Sig_out = LD_inv %*% (Sigma * crossprod(t(se_G))) %*% LD_inv
  
  Sig_exp_inv = solve(Sig_exp)
  Sig_out_inv = solve(Sig_out)
  
  #Return a list of results
  list(
    LD = Sigma,
    beta_E = beta_E,
    beta_G = beta_G,
    theta = theta,
    tau = tau,
    gamma = gamma,
    bx = beta_E_hat,
    bxse = se_E,
    by = beta_G_hat,
    byse = se_G,
    Zx = beta_E_hat / se_E,
    Zy = beta_G_hat / se_G,
    b_exp_cond = b_exp_cond,
    b_out_cond = b_out_cond,
    Sig_out_inv = Sig_out_inv,
    n_exp = n_exp,
    n_out = n_out
  )
}

################ Extract BETA, SE, P, LCI, UCI from MR result objects ########################
safe <- function(expr) {
  tryCatch(expr, error = function(e) return(NA))
}


extract_result <- function(method_name, beta, se, p) {
  if (any(is.na(c(beta, se, p)))) {
    return(data.table(method = method_name, beta = NA, se = NA, p = NA,
                      LCI = NA, UCI = NA))
  }
  LCI = beta - 1.96 * se
  UCI = beta + 1.96 * se
  data.table(method = method_name, beta = beta, se = se, p = p, LCI = LCI, UCI = UCI)
}

########################### MR performing engine #############################
run_methods <- function(sim) {
  
  LD_mat <- sim$LD
  bx   <- as.numeric(sim$bx)
  bxse <- as.numeric(sim$bxse)
  by   <- as.numeric(sim$by)
  byse <- as.numeric(sim$byse)
  
  mr_obj.correl <- MendelianRandomization::mr_input(
    bx = bx, bxse = bxse, by = by, byse = byse, corr = LD_mat)
  
  results <- list()
  
  ### 1. gIVW
  givw <- safe(MendelianRandomization::mr_ivw(mr_obj.correl, 
                                              model = "default",
                                              correl = TRUE,
                                              distribution = "normal",
                                              alpha = 0.05))
results[[1]] <- extract_result("gIVW",
                               beta = safe(givw@Estimate),
                               se   = safe(givw@StdError),
                               p    = safe(givw@Pvalue))

### 2. gEgger
gegger <- safe(MendelianRandomization::mr_egger(mr_obj.correl, 
                                                correl = TRUE,
                                                distribution = "normal",
                                                alpha = 0.05))
results[[2]] <- extract_result("gEgger",
                               beta = safe(gegger@Estimate),
                               se   = safe(gegger@StdError.Est),
                               p    = safe(gegger@Pvalue.Est))

### 3. PC-GMM
pc_gmm <- safe(MendelianRandomization::mr_pcgmm(mr_obj.correl, 
                                                nx = sim$n_exp,
                                                ny = 90000,
                                                r = 170, thres = 0.999,
                                                robust = TRUE, alpha = 0.05))
results[[3]] <- extract_result("PC-GMM",
                               beta = safe(pc_gmm@Estimate),
                               se   = safe(pc_gmm@StdError),
                               p    = safe(pc_gmm@Pvalue))

### 4. LDA-Egger
lda_egger <- safe(LDA.MREgger(sim$b_exp_cond, sim$b_out_cond, sim$Sig_out_inv))
results[[4]] <- extract_result("LDA-Egger",
                               beta = safe(lda_egger[2,1]),
                               se   = safe(sqrt(lda_egger[2,2])),
                               p    = safe(lda_egger[2,4]))

### 5. PCA-IVW
pca_ivw <- safe(pca_ivw(bx, by, byse, LD_mat))
results[[5]] <- extract_result("PCA-IVW",
                               beta = safe(pca_ivw$beta),
                               se   = safe(pca_ivw$se_beta),
                               p    = safe(pca_ivw$pval))

### 6. MR-link-2
mr_link_2 <- safe(mr_link2_analysis(bx, by, LD_mat, sim$n_exp, 90000))
results[[6]] <- extract_result("MR-link-2",
                               beta = safe(mr_link_2$alpha),
                               se   = safe(mr_link_2$`se(alpha)`),
                               p    = safe(mr_link_2$`p(alpha)`))

rbindlist(results)
}

