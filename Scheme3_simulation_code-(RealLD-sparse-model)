simulate_exp_outcome_sumstats <- function(
    R_mat,                     # LD matrix (same role as r_mat in Python)
    causal_effect = 0.2,
    n_exp = 30000,
    n_out = 90000,
    exp_h2 = 0.1,
    out_h2 = 0,
    m_causal_exp = 10,
    m_causal_out = 10,
    min_ld_between_causal = 0.0,
    max_ld_between_causal = 1.0
) {
  
  J <- nrow(R_mat)
  
  # ===== 1. Select causal SNPs (MR-link logic) =====
  snp_sel <- select_causal_snps(
    n_exp_causal = m_causal_exp,
    n_out_causal = m_causal_out,
    n_overlap = 0,
    R = R_mat,
    n_reps = 1,
    upper_ld_bound = max_ld_between_causal,
    lower_ld_bound = min_ld_between_causal
  )
  
  causal_X <- which(snp_sel$exposure[,1])
  causal_Y <- which(snp_sel$outcome[,1])
  
  # ===== 2. Generate true SNP-exposure/outcome effects =====
  sigma_exp <- sqrt(exp_h2 / m_causal_exp)
  sigma_out <- sqrt(out_h2 / m_causal_out)
  
  gamX <- rep(0, J)
  gamY <- rep(0, J)
  
  gamX[causal_X] <- rnorm(length(causal_X), 0, sigma_exp)
  gamY[causal_Y] <- rnorm(length(causal_Y), 0, sigma_out)

  gamX <- as.numeric(gamX)
  gamY <- as.numeric(gamY)

  # ===== 3. Generate observed SNP-exposure/outcome with LD projection =====
  # Noise variances 
  noise_exp_cov <- R_mat * ((1 - exp_h2) / n_exp)
  noise_out_cov <- R_mat * ((1 - causal_effect^2 * exp_h2 - out_h2) / n_out)
  
  noise_X <- as.numeric(MASS::mvrnorm(1, rep(0, J), noise_exp_cov))
  noise_Y <- as.numeric(MASS::mvrnorm(1, rep(0, J), noise_out_cov))
  noise_X <- as.numeric(noise_X)
  noise_Y <- as.numeric(noise_Y)
  
  betX <- as.numeric(R_mat %*% gamX) + noise_X
  betY <- as.numeric(R_mat %*% (causal_effect * gamX + gamY)) + noise_Y
  
  # ===== 4. Standard errors & Z-scores =====
  seX <- sqrt((1 - exp_h2) / n_exp)
  seY <- sqrt((1 - causal_effect^2 * exp_h2 - out_h2) / n_out)
  
  Zx <- betX / seX
  Zy <- betY / seY
  
  # ===== 5. Conditional SNP-exposure/outcome assoc estimate for LDA-Egger =====
  LDinv <- solve(R_mat)
  
  b_exp_cond <- LDinv %*% betX
  b_out_cond <- LDinv %*% betY
  
  Sig_exp  <- LDinv %*% (R_mat * seX^2) %*% LDinv
  Sig_out  <- LDinv %*% (R_mat * seY^2) %*% LDinv
  
  Sig_out_inv <- solve(Sig_out)
  
  # ===== Return sumstats =====
  list(
    LD = R_mat,
    gamX = gamX,
    gamY = gamY,
    causal_X = causal_X,
    causal_Y = causal_Y,
    betX = drop(betX),
    betY = drop(betY),
    seX = rep(seX, J),
    seY = rep(seY, J),
    Zx = Zx,
    Zy = Zy,
    b_exp_cond = drop(b_exp_cond),
    b_out_cond = drop(b_out_cond),
    Sig_out_inv = Sig_out_inv,
    n_exp = n_exp
  )
}

################ Extract BETA, SE, P, LCI, UCI from MR result objects ########################
safe <- function(expr) {
  tryCatch(expr, error = function(e) return(NA))
}

extract_result <- function(method_name, beta, se, p) {
  if (any(is.na(c(beta, se, p)))) {
    return(data.table(method = method_name, beta = NA, se = NA, p = NA,
                      LCI = NA, UCI = NA))
  }
  LCI = beta - 1.96 * se
  UCI = beta + 1.96 * se
  data.table(method = method_name, beta = beta, se = se, p = p, LCI = LCI, UCI = UCI)
}

########################### MR performing engine #############################
run_methods <- function(sim) {
  
  LD_mat <- sim$LD
  bx   <- as.numeric(sim$betX)
  bxse <- as.numeric(sim$seX)
  by   <- as.numeric(sim$betY)
  byse <- as.numeric(sim$seY)
  
  mr_obj.correl <- MendelianRandomization::mr_input(
    bx = bx, bxse = bxse, by = by, byse = byse, corr = LD_mat)
  
  results <- list()
  
  ### 1. gIVW
  givw <- safe(MendelianRandomization::mr_ivw(mr_obj.correl, 
                                              model = "default",
                                              correl = TRUE,
                                              distribution = "normal",
                                              alpha = 0.05))
  results[[1]] <- extract_result("gIVW",
                                 beta = safe(givw@Estimate),
                                 se   = safe(givw@StdError),
                                 p    = safe(givw@Pvalue))
  
  ### 2. gEgger
  gegger <- safe(MendelianRandomization::mr_egger(mr_obj.correl, 
                                                  correl = TRUE,
                                                  distribution = "normal",
                                                  alpha = 0.05))
  results[[2]] <- extract_result("gEgger",
                                 beta = safe(gegger@Estimate),
                                 se   = safe(gegger@StdError.Est),
                                 p    = safe(gegger@Pvalue.Est))
  
  ### 3. PC-GMM
  pc_gmm <- safe(MendelianRandomization::mr_pcgmm(mr_obj.correl, 
                                                  nx = sim$n_exp,
                                                  ny = 90000,
                                                  r = 170, thres = 0.999,
                                                  robust = TRUE, alpha = 0.05))
  results[[3]] <- extract_result("PC-GMM",
                                 beta = safe(pc_gmm@Estimate),
                                 se   = safe(pc_gmm@StdError),
                                 p    = safe(pc_gmm@Pvalue))
  
  ### 4. LDA-Egger
  lda_egger <- safe(LDA.MREgger(sim$b_exp_cond, sim$b_out_cond, sim$Sig_out_inv))
  results[[4]] <- extract_result("LDA-Egger",
                                 beta = safe(lda_egger[2,1]),
                                 se   = safe(sqrt(lda_egger[2,2])),
                                 p    = safe(lda_egger[2,4]))
  
  ### 5. PCA-IVW
  pca_ivw <- safe(pca_ivw(bx, by, byse, LD_mat))
  results[[5]] <- extract_result("PCA-IVW",
                                 beta = safe(pca_ivw$beta),
                                 se   = safe(pca_ivw$se_beta),
                                 p    = safe(pca_ivw$pval))
  
  ### 6. MR-link-2
  mr_link_2 <- safe(mr_link2_analysis(bx, by, LD_mat, sim$n_exp, 90000))
  results[[6]] <- extract_result("MR-link-2",
                                 beta = safe(mr_link_2$alpha),
                                 se   = safe(mr_link_2$`se(alpha)`),
                                 p    = safe(mr_link_2$`p(alpha)`))
  
  rbindlist(results)
}

###################### Looping code to generate GWAS summary statistics and run MR on generated data  ##################

worker_results <- mclapply(seq_len(n_core), function(wid) {
  
  .Random.seed <- worker_streams[[wid]]
  
  L <- vector("list", n_sim_per_core)
  
  for (r in 1:n_sim_per_core) {
    
    .Random.seed <- parallel::nextRNGSubStream(.Random.seed)
    
    sim <- simulate_exp_outcome_sumstats(
      R_mat = Sigma_reg,
      causal_effect = P$gamma,
      n_exp  = P$n_exp,
      n_out  = n_out,
      exp_h2 = exp_h2,
      out_h2 = P$out_h2,
      m_causal_exp = P$n_causal,
      m_causal_out = P$n_causal,
      min_ld_between_causal = P$ld_min,
      max_ld_between_causal = P$ld_max
    )
    
    M <- run_methods(sim)
    
    M[, `:=`(
      sim_id = (wid - 1L) * n_sim_per_core + r,
      combo_id = P$combo_id,
      n_exp = P$n_exp,
      gamma = P$gamma,
      out_h2 = P$out_h2,
      rho = P$rho,
      n_causal = P$n_causal,
      ld_min = P$ld_min,
      ld_max = P$ld_max
    )]
    
    L[[r]] <- M
  }
  
  rbindlist(L)
  
}, mc.cores = n_core, mc.preschedule = TRUE)

############# Compile result files #############
final <- rbindlist(worker_results)

suffix <- sprintf("_%03d", as.integer(combo_id))
outfile <- file.path(outdir, sprintf("mr_corr_sims_realLD_sparse_combo%s.csv", suffix))
write.csv(final, outfile, row.names = FALSE)
